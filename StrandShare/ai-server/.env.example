# Copy this file to `.env` next to docker-compose.yml and fill in the values.

# Supabase project URL, e.g. https://abcd.supabase.co
SUPABASE_URL=

# Supabase secret key (NOT the publishable/anon key). The AI server uses it server-side to
# publish only approved/staged transparent PNGs and update Wig_AI_Filters.
# Raw wig photos and try-on portraits never use Supabase Storage.
SUPABASE_SECRET_KEY=
# Legacy projects may use SUPABASE_SERVICE_ROLE_KEY instead.

# Bucket names from migration 089_wig_ai_filter_storage.sql.
WIG_AI_SOURCES_BUCKET=wig_ai_sources
WIG_AI_FILTERS_BUCKET=wig_ai_filters

# Local models. First run downloads the weights once; after that there is no
# API call, usage quota, or per-image fee.
REMBG_MODEL=birefnet-general
CLIP_MODEL=openai/clip-vit-base-patch32
LOCAL_MODELS_ONLY=0
MAX_UPLOAD_MB=15

# CORS for local development and the deployed Donivra frontend.
# Comma-separated list, no spaces.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://donivra.vercel.app

# Keep the heavy AI ready after the controller starts at Windows sign-in.
# Turning it off manually keeps it off until you turn it on or restart the controller.
AI_ALWAYS_ON=1

# Used only when AI_ALWAYS_ON=0.
AI_IDLE_TIMEOUT_MINUTES=15
