# Copy this file to `.env` next to docker-compose.yml and fill in the values.

# Supabase project URL, e.g. https://abcd.supabase.co
SUPABASE_URL=

# Service-role key (NOT the anon key). The AI server uses it server-side to
# read source images from the private wig_ai_sources bucket and to update
# Wig_AI_Filters rows. Keep it out of git.
SUPABASE_SERVICE_ROLE_KEY=

# Bucket names from migration 089_wig_ai_filter_storage.sql.
WIG_AI_SOURCES_BUCKET=wig_ai_sources
WIG_AI_FILTERS_BUCKET=wig_ai_filters

# TripoSR settings tuned for 4 GB VRAM (RTX 3050 Laptop). Bump on larger GPUs.
TRIPOSR_MC_RESOLUTION=192     # marching-cubes grid resolution
TRIPOSR_FOREGROUND_RATIO=0.85
TRIPOSR_RENDER_RESOLUTION=512 # input image is downscaled to this side length
TRIPOSR_FP16=1                # 1 = use float16, 0 = float32 (slower but more VRAM-safe-ish)

# CORS for the React dev server. Comma-separated list, no spaces.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
